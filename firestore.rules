rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /rsvps/{rsvpId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'totalGuests', 'status', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.totalGuests is int
        && request.resource.data.totalGuests >= 1
        && request.resource.data.status is string
        && (request.resource.data.status == 'Hadir' || request.resource.data.status == 'Tidak Hadir')
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }
  }
}
